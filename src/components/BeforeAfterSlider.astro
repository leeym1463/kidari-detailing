---
// 시공 전후 비교 슬라이더 (frontmatter 의 beforeAfter 로 넣는 경우).
//
// 스타일과 동작은 페이지 단위로 한 번만 불러옵니다
//   · src/styles/before-after.css
//   · src/scripts/before-after.ts
// 관리자 CMS 가 만든 글은 본문 안에 아래와 같은 마크업을 직접 넣으므로,
// 여기 구조를 바꾸면 src/lib/blocks-render.ts 의 sliderHtml() 도 함께 고쳐야 합니다.
interface Props {
  before: string;
  after: string;
  beforeAlt?: string;
  afterAlt?: string;
  caption?: string;
}

const { before, after, beforeAlt = '시공 전', afterAlt = '시공 후', caption } = Astro.props;
---

<figure class="ba-slider">
  <div class="ba-frame">
    <img class="ba-img ba-after" src={after} alt={afterAlt} loading="lazy" />
    <div class="ba-before-wrap">
      <img class="ba-img ba-before" src={before} alt={beforeAlt} loading="lazy" />
    </div>
    <span class="ba-tag ba-tag-before">BEFORE</span>
    <span class="ba-tag ba-tag-after">AFTER</span>
    <div class="ba-handle" aria-hidden="true">
      <span class="ba-handle-grip">↔</span>
    </div>
    <input
      class="ba-range"
      type="range"
      min="0"
      max="100"
      value="50"
      aria-label="시공 전/후 비교 슬라이더"
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
