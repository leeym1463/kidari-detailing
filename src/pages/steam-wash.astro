---
import Layout from '../layouts/Layout.astro';
import FaqList from '../components/FaqList.astro';
import CasePreview from '../components/CasePreview.astro';
import { business } from '../data/business';
import { faqsByCategory } from '../data/faq';
import { serviceSchema, faqPageSchema, breadcrumbSchema } from '../utils/schema';
import {
  washTiers,
  vehicleSizePrices,
  waxOptions,
  washPriceRange,
  washPriceNote,
  evaCleaningPrice,
} from '../data/washPricing';
import { formatManwon } from '../utils/format';

const title = '스팀세차 | 요금표 - 키다리광택 (춘천)';
const description =
  '강원도 춘천 키다리광택의 스팀세차 서비스 안내. 베이직·디테일링·키다리스타일 등급별 차종별 요금표, 일반세차와의 차이, 주의사항을 확인하세요.';

const pageFaqs = faqsByCategory('스팀세차');

const schema = [
  serviceSchema({
    name: '스팀세차',
    description,
    path: '/steam-wash',
    serviceType: '자동차 스팀세차',
    lowPrice: washPriceRange.low,
    highPrice: washPriceRange.high,
  }),
  faqPageSchema(pageFaqs),
  breadcrumbSchema([
    { name: '홈', path: '/' },
    { name: '스팀세차', path: '/steam-wash' },
  ]),
];
---

<Layout title={title} description={description} path="/steam-wash" schema={schema}>
  <section class="page-hero">
    <div class="wrap">
      <p class="breadcrumb"><a href="/">홈</a> / 스팀세차</p>
      <h1>스팀세차</h1>
      <p class="lede">
        스팀세차는 고온·고압의 스팀을 이용해 차량 실내외의 오염물을 세척하는 세차 방식입니다.
        키다리광택은 광택·코팅 작업 전후 관리용으로, 또는 단독 서비스로 스팀세차를 제공합니다.
      </p>
    </div>
  </section>

  <div class="wrap section prose">
    <h2>스팀세차란</h2>
    <p>
      스팀세차는 물을 고온으로 가열해 발생시킨 스팀을 이용해 표면의 오염물과 세균을
      제거하는 세차 방식입니다. 일반 물세차보다 적은 물 사용량으로 세정이 가능하고,
      시트·매트·에어컨 송풍구 등 물을 직접 뿌리기 어려운 실내 부위까지 세척할 수 있다는
      특징이 있습니다.
    </p>

    <h2>일반세차와의 차이</h2>
    <p>
      일반 물세차는 많은 양의 물을 뿌려가며 오염물을 씻어내는 방식이고, 스팀세차는 물을 고온으로
      가열해 만든 스팀으로 오염물과 세균을 제거하는 방식입니다. 스팀세차는 물 사용량이 적고,
      시트·매트·에어컨 송풍구처럼 물을 직접 뿌리기 어려운 실내 부위까지 세척할 수 있다는 장점이
      있습니다. 다만 오래되어 심하게 눌어붙은 오염이나 기름때는 스팀만으로 완전히 제거되지
      않을 수 있어, 이런 경우에는 별도의 세정제나 손세차를 함께 진행할 수 있습니다.
    </p>

    <h2>등급 안내</h2>
    <p>키다리광택 스팀세차는 베이직·디테일링·키다리스타일 세 가지 등급으로 운영합니다.</p>
    {washTiers.map((tier) => (
      <>
        <h3>{tier.name} ({tier.duration})</h3>
        <ul>
          {tier.features.map((f) => <li>{f}</li>)}
        </ul>
        {tier.note && <p><em>{tier.note}</em></p>}
      </>
    ))}

    <h2>차종·등급별 요금표</h2>
    <p class="note-box">{washPriceNote}</p>
    <div class="table-scroll">
      <table class="price-table">
        <caption>차종·등급별 스팀세차 요금</caption>
        <thead>
          <tr>
            <th scope="col">차량 크기</th>
            {washTiers.map((tier) => <th scope="col">{tier.name}</th>)}
          </tr>
        </thead>
        <tbody>
          {vehicleSizePrices.map((v) => (
            <tr>
              <td>{v.name}</td>
              {washTiers.map((tier) => <td>{formatManwon(v.prices[tier.key])}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3>왁스 업그레이드 옵션 (디테일링 등급 기준)</h3>
    <div class="table-scroll">
      <table class="price-table">
        <caption>왁스 등급별 추가 요금</caption>
        <thead>
          <tr>
            <th scope="col">왁스 종류</th>
            <th scope="col">지속 기간</th>
            <th scope="col">추가 요금</th>
          </tr>
        </thead>
        <tbody>
          {waxOptions.map((w) => (
            <tr>
              <td>{w.name}</td>
              <td>{w.duration}</td>
              <td>+{formatManwon(w.extra)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      베이직 등급도 왁스 추가가 가능하며 기본 2만원부터 시작합니다. 정확한 견적은 방문 또는
      전화 상담을 통해 안내해 드립니다.
    </p>

    <h3>에바크리닝</h3>
    <p>
      에어컨 냄새 제거·살균이 필요하시다면 에바크리닝을 별도로 진행할 수 있습니다. 가격은{' '}
      {formatManwon(evaCleaningPrice)}입니다.
    </p>

    <h2>주의할 점</h2>
    <p>
      스팀세차는 고온의 스팀을 사용하기 때문에 블랙박스, 오디오, 에어컨 조작부 같은 전장
      부품 주변에는 직접 닿지 않도록 주의가 필요합니다. 또한 오래되어 심하게 눌어붙은
      오염이나 기름때는 스팀만으로 완전히 제거되지 않을 수 있어, 이런 경우에는 별도의
      세정제나 손세차를 함께 진행해야 할 수 있습니다. 오염도에 따라 추가 요금이 발생할 수
      있습니다.
    </p>

    <h2>자주 묻는 질문</h2>
    <FaqList items={pageFaqs} />
    <p style="margin-top:16px;">
      <a href="/faq">전체 FAQ 더 보기 →</a>
    </p>
  </div>

  <section class="section section-alt">
    <div class="wrap">
      <CasePreview category="스팀세차" />
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2>스팀세차 문의</h2>
      <p class="section-lead">예약 및 가격 문의는 전화로 안내해 드립니다.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={business.telephoneHref}>{business.telephoneDisplay} 전화하기</a>
        <a class="btn btn-outline-primary" href="/contact">오시는 길 보기</a>
      </div>
    </div>
  </section>
</Layout>
