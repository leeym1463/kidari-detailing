---
// /admin/cases/edit — 시공사례 작성·수정 화면.
//
// 주소에 ?id= 가 있으면 그 글을 불러오고, 없으면 새 글입니다.
// 새 글은 처음 내용을 입력하는 순간 임시저장 글이 만들어집니다
// (빈 글이 목록에 쌓이지 않게 하기 위해서입니다).
//
// 화면 구성은 네이버 블로그 글쓰기를 따릅니다.
//   위:   제목
//   가운데: 본문 (화면 대부분)
//   아래: 기본정보 — 기본적으로 접혀 있음
//   오른쪽: 사진함 (넓은 화면 고정 / 좁은 화면은 전체 덮개)
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { CASE_CATEGORIES } from '../../../lib/cms-types';
---

<AdminLayout title="시공사례 작성" nav="cases">
  <div class="ad-editor-bar">
    <div class="inner">
      <span class="title" id="bar-title">새 시공사례</span>
      <span class="ad-save-state" id="save-state" role="status" aria-live="polite"></span>
      <button type="button" id="btn-save" class="ad-btn ad-btn-primary ad-btn-sm" aria-label="임시저장">
        임시저장
      </button>
      <a id="btn-preview" class="ad-btn ad-btn-sm" href="#" aria-label="미리보기">미리보기</a>
      <button type="button" id="btn-open-panel" class="ad-btn ad-btn-sm" aria-label="사진함 열기">
        사진함
      </button>
      <a class="ad-btn ad-btn-sm" href="/admin/cases" aria-label="목록으로 돌아가기">목록</a>
    </div>
  </div>

  <p id="edit-error" class="ad-notice ad-hide" role="alert"></p>

  <div class="ad-editor-grid with-panel" id="editor-grid">
    <div>
      <!-- ============ 제목 ============ -->
      <div class="ad-title-field">
        <input
          id="f-title"
          class="ad-title-input"
          type="text"
          maxlength="120"
          aria-label="시공사례 제목"
          placeholder="제목을 입력하세요"
          autocomplete="off"
        />
      </div>

      <!-- ============ 본문 ============ -->
      <div class="ad-body-card">
        <div id="block-editor" aria-label="본문"></div>
      </div>

      <!-- ============ 기본정보 (접힘) ============ -->
      <details class="ad-section ad-meta" id="basic-section">
        <summary aria-label="기본정보 펼치기 또는 접기">기본정보</summary>
        <div class="body">
          <p class="ad-small ad-muted" style="margin:0 0 16px;">
            글을 쓰는 데 꼭 필요하지는 않습니다. 비워두어도 임시저장됩니다.
          </p>

          <div class="ad-meta-grid">
            <div class="ad-field">
              <label for="f-category">카테고리</label>
              <select id="f-category" class="ad-select" aria-label="카테고리">
                {CASE_CATEGORIES.map((c) => <option value={c}>{c}</option>)}
              </select>
            </div>

            <div class="ad-field">
              <label for="f-date">작업일</label>
              <input id="f-date" class="ad-input" type="date" aria-label="작업일" />
            </div>

            <div class="ad-field">
              <label for="f-vehicle">차량명</label>
              <input id="f-vehicle" class="ad-input" type="text" maxlength="80" aria-label="차량명"
                placeholder="예) BMW 740i" />
            </div>

            <div class="ad-field">
              <label for="f-color">차량 색상</label>
              <input id="f-color" class="ad-input" type="text" maxlength="40" aria-label="차량 색상"
                placeholder="예) 알파인 화이트" />
            </div>
          </div>

          <div class="ad-field" style="margin-bottom:0;">
            <label for="f-blog">네이버 블로그 URL</label>
            <input id="f-blog" class="ad-input" type="url" inputmode="url"
              aria-label="네이버 블로그 URL" placeholder="https://blog.naver.com/..." />
            <p class="ad-hint">블로그 글을 옮겨 적었다면 원본 주소를 남겨두세요.</p>
          </div>
        </div>
      </details>
    </div>

    <!-- ============ 사진함 패널 ============ -->
    <aside class="ad-panel ad-hide" id="photo-panel" aria-label="사진함">
      <div class="ad-panel-head">
        <h2 id="panel-title">사진함</h2>
        <button type="button" id="panel-close" class="ad-btn ad-btn-sm" style="margin-left:auto;"
          aria-label="사진함 닫기">닫기</button>
      </div>

      <div class="ad-panel-body">
        <p class="ad-panel-hint" id="panel-hint">글에 넣을 사진을 미리 올려두세요.</p>

        <label class="ad-btn ad-btn-sm ad-btn-block" for="panel-upload" aria-label="사진 추가">
          사진 추가
        </label>
        <input id="panel-upload" type="file" accept="image/*" multiple aria-label="올릴 사진 선택"
          style="position:absolute;width:1px;height:1px;opacity:0;" />
        <ul class="ad-progress" id="panel-progress" aria-live="polite"></ul>

        <div class="ad-photo-grid" id="panel-grid" style="margin-top:14px;"></div>
        <div class="ad-empty ad-hide" id="panel-empty">
          <p>사진함이 비어 있습니다.</p>
        </div>
      </div>

      <div class="ad-panel-foot ad-hide" id="panel-foot">
        <button type="button" id="panel-confirm" class="ad-btn ad-btn-primary ad-btn-sm"
          aria-label="고른 사진 넣기">선택한 사진 넣기</button>
        <button type="button" id="panel-cancel" class="ad-btn ad-btn-sm"
          aria-label="사진 고르기 취소">취소</button>
      </div>
    </aside>
  </div>
</AdminLayout>

<script>
  import { bootAdmin } from '../../../lib/admin-guard';
  import { BlockEditor } from '../../../lib/block-editor';
  import { createUploader, PhotoGallery } from '../../../lib/photo-gallery';
  import {
    CASE_CATEGORIES,
    firstPhotoPath,
    usedPhotoPaths,
    type CaseCategory,
    type CaseRow,
  } from '../../../lib/cms-types';
  import {
    buildSlug,
    debounce,
    el,
    friendlyError,
    maybe,
    notice,
    show,
    toast,
    todayISO,
  } from '../../../lib/admin-ui';

  const AUTOSAVE_MS = 1500;

  (async () => {
    const session = await bootAdmin();
    if (!session) return;
    const { api } = session;

    // id 가 없으면 새 글입니다. 실제 글은 처음 저장할 때 만들어집니다.
    let caseId = new URLSearchParams(location.search).get('id');
    let row: CaseRow | null = null;

    if (caseId) {
      try {
        row = await api.getCase(caseId);
      } catch (e) {
        notice(maybe('edit-error'), friendlyError(e), 'error');
        return;
      }
      if (!row) {
        notice(maybe('edit-error'), '글을 찾을 수 없습니다. 목록에서 다시 들어와주세요.', 'error');
        return;
      }
    }

    // ----------------------------------------------------------------
    // 입력칸 채우기
    //
    // 화면에 없는 항목(요약·입고상태·작업내용·작업시간·가격안내)은
    // 저장할 때도 건드리지 않습니다 — 예전에 입력한 값이 지워지지 않게 하기 위해서입니다.
    // ----------------------------------------------------------------
    const F = {
      title: el<HTMLInputElement>('f-title'),
      category: el<HTMLSelectElement>('f-category'),
      vehicle: el<HTMLInputElement>('f-vehicle'),
      date: el<HTMLInputElement>('f-date'),
      color: el<HTMLInputElement>('f-color'),
      blog: el<HTMLInputElement>('f-blog'),
    };

    F.title.value = row?.title ?? '';
    F.category.value =
      row && CASE_CATEGORIES.includes(row.category) ? row.category : CASE_CATEGORIES[0];
    F.vehicle.value = row?.vehicle ?? '';
    F.date.value = row?.case_date ?? todayISO();
    F.color.value = row?.vehicle_color ?? '';
    F.blog.value = row?.naver_blog_url ?? '';

    function syncHeader() {
      el('bar-title').textContent = F.title.value.trim() || (caseId ? '제목 없음' : '새 시공사례');
      const link = el<HTMLAnchorElement>('btn-preview');
      if (caseId) {
        link.href = `/admin/cases/preview?id=${encodeURIComponent(caseId)}`;
        link.removeAttribute('aria-disabled');
      } else {
        link.href = '#';
        link.setAttribute('aria-disabled', 'true');
      }
    }
    syncHeader();

    // ----------------------------------------------------------------
    // 사진함 패널
    // ----------------------------------------------------------------
    const panel = el('photo-panel');
    const panelFoot = el('panel-foot');
    let pickResolve: ((paths: string[]) => void) | null = null;
    let pickLimit: 'one' | 'many' = 'many';

    const wide = () => window.matchMedia('(min-width: 1024px)').matches;

    const gallery = new PhotoGallery({
      grid: el('panel-grid'),
      empty: maybe('panel-empty'),
      api,
      selectable: true,
      multiple: true,
      deletable: false,
      onSelectionChange: () => updateConfirmLabel(),
    });

    function updateConfirmLabel() {
      const n = gallery.selected.length;
      el('panel-confirm').textContent = n > 0 ? `선택한 사진 ${n}장 넣기` : '선택한 사진 넣기';
    }

    function openPanel(mode: 'browse' | 'pick', title: string, hint: string) {
      el('panel-title').textContent = title;
      el('panel-hint').textContent = hint;
      show(panelFoot, mode === 'pick');
      show(panel, true);
    }

    function openPanelBrowse() {
      openPanel('browse', '사진함', '글에 넣을 사진을 미리 올려두세요.');
    }

    function finishPick(paths: string[]) {
      const done = pickResolve;
      pickResolve = null;
      gallery.clearSelection();
      show(panelFoot, false);
      if (wide()) openPanelBrowse();
      else show(panel, false);
      done?.(paths);
    }

    el('panel-close').addEventListener('click', () => {
      if (pickResolve) finishPick([]);
      else show(panel, false);
    });
    el('btn-open-panel').addEventListener('click', () => openPanelBrowse());
    el('panel-cancel').addEventListener('click', () => finishPick([]));

    el('panel-confirm').addEventListener('click', () => {
      if (!pickResolve) return;
      let picked = gallery.selected.map((p) => p.storage_path);
      if (picked.length === 0) {
        toast('사진을 먼저 고르세요.', 'error');
        return;
      }
      if (pickLimit === 'one') picked = picked.slice(0, 1);
      finishPick(picked);
    });

    createUploader({
      api,
      input: el<HTMLInputElement>('panel-upload'),
      progress: maybe('panel-progress'),
      onDone: async () => {
        await gallery.refresh();
        editor.refreshThumbs();
      },
    });

    // ----------------------------------------------------------------
    // 블록 편집기
    // ----------------------------------------------------------------
    const editor = new BlockEditor(el('block-editor'), {
      thumbUrl: (path) => gallery.thumbUrl(path),
      pickPhotos: ({ multiple, title }) =>
        new Promise<string[]>((resolve) => {
          pickResolve = resolve;
          pickLimit = multiple ? 'many' : 'one';
          gallery.clearSelection();
          updateConfirmLabel();
          openPanel(
            'pick',
            title,
            multiple
              ? '넣을 사진을 차례대로 누르세요. 누른 순서대로 들어갑니다.'
              : '넣을 사진 한 장을 누르세요.'
          );
        }),
      onChange: () => scheduleSave(),
    });

    // ----------------------------------------------------------------
    // 저장
    // ----------------------------------------------------------------
    const stateNode = el('save-state');
    let saving = false;
    let dirtyWhileSaving = false;

    function setState(text: string, kind: '' | 'saving' | 'saved' | 'error') {
      stateNode.textContent = text;
      stateNode.className = 'ad-save-state' + (kind ? ' is-' + kind : '');
    }

    function collect() {
      const blocks = editor.getBlocks();
      return {
        patch: {
          title: F.title.value.trim(),
          category: F.category.value as CaseCategory,
          case_date: F.date.value || todayISO(),
          vehicle: F.vehicle.value.trim() || null,
          vehicle_color: F.color.value.trim() || null,
          naver_blog_url: F.blog.value.trim() || null,
          content_blocks: blocks,
          cover_image: firstPhotoPath(blocks),
        },
        used: usedPhotoPaths(blocks),
      };
    }

    /** 아직 아무것도 입력하지 않았으면 빈 글을 만들지 않습니다. */
    function hasContent(): boolean {
      if (F.title.value.trim()) return true;
      if (F.vehicle.value.trim() || F.color.value.trim() || F.blog.value.trim()) return true;
      return editor.getBlocks().length > 0;
    }

    async function save(manual = false): Promise<void> {
      if (saving) {
        dirtyWhileSaving = true;
        return;
      }
      if (!caseId && !hasContent()) {
        if (manual) toast('제목이나 내용을 먼저 입력해주세요.', 'error');
        return;
      }

      saving = true;
      setState('저장 중…', 'saving');
      const { patch, used } = collect();

      try {
        if (!caseId) {
          // 첫 저장 — 이때 비로소 임시저장 글이 만들어집니다.
          const created = await api.createCase({
            slug: buildSlug(patch.category, patch.case_date),
            title: patch.title || '제목 없음',
            category: patch.category,
            case_date: patch.case_date,
          });
          caseId = created.id;
          // 새로고침해도 같은 글로 돌아오도록 주소만 조용히 바꿉니다.
          history.replaceState(null, '', `/admin/cases/edit?id=${encodeURIComponent(caseId)}`);
        }

        await api.updateCase(caseId, patch);
        await api.syncCasePhotos(caseId, used);

        setState('저장됨', 'saved');
        syncHeader();
        notice(maybe('edit-error'), '');
        if (manual) toast('임시저장했습니다.', 'ok');
        await gallery.refresh();
        editor.refreshThumbs();
      } catch (e) {
        setState('저장하지 못했습니다', 'error');
        notice(maybe('edit-error'), friendlyError(e), 'error');
        if (manual) toast(friendlyError(e), 'error');
      } finally {
        saving = false;
        if (dirtyWhileSaving) {
          dirtyWhileSaving = false;
          scheduleSave();
        }
      }
    }

    const scheduleSave = debounce(() => void save(false), AUTOSAVE_MS);

    for (const node of Object.values(F)) {
      node.addEventListener('input', () => {
        setState('수정 중…', '');
        if (node === F.title) syncHeader();
        scheduleSave();
      });
    }

    el('btn-save').addEventListener('click', () => {
      scheduleSave.flush();
      void save(true);
    });

    // 미리보기는 글이 만들어진 뒤에만 열 수 있습니다.
    el('btn-preview').addEventListener('click', (event) => {
      if (!caseId) {
        event.preventDefault();
        toast('먼저 제목이나 내용을 입력해주세요.', 'error');
      }
    });

    window.addEventListener('beforeunload', () => {
      scheduleSave.flush();
    });

    // ----------------------------------------------------------------
    // 시작
    // ----------------------------------------------------------------
    await gallery.refresh();
    editor.setBlocks(row?.content_blocks ?? []);
    editor.refreshThumbs();
    setState(caseId ? '저장됨' : '', caseId ? 'saved' : '');

    if (wide()) openPanelBrowse();
    if (!caseId) F.title.focus();
  })().catch((e) => {
    notice(maybe('edit-error'), friendlyError(e), 'error');
    console.error('[작성 화면]', e);
  });
</script>
