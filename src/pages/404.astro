---
// 없는 주소로 들어왔을 때 보여줄 화면.
//
// 왜 필요한가
//   Cloudflare Pages 는 404.html 이 없으면 없는 주소에도 홈 화면을 200 으로
//   돌려줍니다. 그러면 존재하지 않는 주소가 전부 정상 페이지로 색인될 수 있습니다.
//   이 파일이 dist/404.html 로 만들어지면 Cloudflare 가 제대로 404 를 돌려줍니다.
//
// 색인에서는 빠지도록 noindex 를 주고, 사이트맵에서도 제외합니다
// (astro.config.mjs 의 sitemap filter).
import Layout from '../layouts/Layout.astro';
import { business } from '../data/business';

const title = '페이지를 찾을 수 없습니다 | 키다리광택';
const description = '요청하신 페이지를 찾을 수 없습니다. 키다리광택 홈이나 시공사례에서 원하시는 내용을 찾아보세요.';
---

<Layout title={title} description={description} path="/404" noindex>
  <section class="page-hero">
    <div class="wrap">
      <span class="case-tag">404</span>
      <h1 style="margin-top:10px;">페이지를 찾을 수 없습니다</h1>
      <p class="lede">
        주소가 바뀌었거나 삭제된 페이지일 수 있습니다. 아래에서 원하시는 내용을 찾아보세요.
      </p>
    </div>
  </section>

  <div class="wrap section">
    <div class="cta-row">
      <a class="btn btn-primary" href="/">홈으로 가기</a>
      <a class="btn btn-outline" href="/cases">시공사례 보기</a>
    </div>

    <div class="prose" style="margin-top:36px;">
      <h2>이런 것을 찾으셨나요?</h2>
      <ul>
        <li><a href="/gwangtaek">광택</a></li>
        <li><a href="/coating">유리막코팅</a></li>
        <li><a href="/restoration">외형복원·판금도색</a></li>
        <li><a href="/steam-wash">스팀세차</a></li>
        <li><a href="/faq">자주 묻는 질문</a></li>
        <li><a href="/contact">오시는 길·문의</a></li>
      </ul>

      <p>
        찾으시는 내용이 없으면 편하게 전화 주세요.
        <a href={business.telephoneHref}>{business.telephoneDisplay}</a>
      </p>
    </div>
  </div>
</Layout>
