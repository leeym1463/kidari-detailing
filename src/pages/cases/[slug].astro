---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { serviceCategoryHref } from '../../data/categories';
import { blogPostingSchema, breadcrumbSchema } from '../../utils/schema';
import BeforeAfterSlider from '../../components/BeforeAfterSlider.astro';
// 슬라이더는 frontmatter 로도, 본문 안 HTML 로도 나올 수 있어 페이지 단위로 불러옵니다.
import '../../styles/before-after.css';

export async function getStaticPaths() {
  const entries = await getCollection('cases', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const title = `${data.title} | 시공사례 - 키다리광택 (춘천)`;

// summary 등은 선택 항목입니다. 값이 없으면 해당 영역을 감추고,
// 메타 설명처럼 비워둘 수 없는 곳에는 제목으로 대신합니다.
const summary = data.summary?.trim() ?? '';
const description = summary || `${data.title} - 키다리광택 춘천 시공사례`;
const hasBeforeCondition = Boolean(data.beforeCondition?.trim());
const hasWorkPerformed = data.workPerformed.length > 0;
const path = `/cases/${entry.slug}`;
const serviceHref = serviceCategoryHref[data.category];

const facts: { label: string; value: string }[] = [];
if (data.category !== '외형복원·판금도색') facts.push({ label: '차종', value: data.vehicle });
if (data.priceNote) facts.push({ label: '가격', value: data.priceNote });

const schema = [
  blogPostingSchema({ title: data.title, description, path, datePublished: data.date }),
  breadcrumbSchema([
    { name: '홈', path: '/' },
    { name: '시공사례', path: '/cases' },
    { name: data.title, path },
  ]),
];
---

<Layout title={title} description={description} path={path} schema={schema}>
  <section class="page-hero">
    <div class="wrap">
      <p class="breadcrumb">
        <a href="/">홈</a> / <a href="/cases">시공사례</a> / {data.category}
      </p>
      <span class="case-tag">{data.category}</span>
      <h1 style="margin-top:10px;">{data.title}</h1>
      {summary && <p class="lede">{summary}</p>}
    </div>
  </section>

  <div class="wrap section">
    {facts.length > 0 && (
      <dl class="case-fact-grid">
        {facts.map((fact) => (
          <div class="fact">
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    )}

    {data.beforeAfter && data.beforeAfter.length > 0 && (
      <div class="prose">
        <h2>시공 전후 비교</h2>
        {data.beforeAfter.map((pair) => (
          <BeforeAfterSlider before={pair.before} after={pair.after} caption={pair.caption} />
        ))}
      </div>
    )}

    <div class="prose">
      {hasBeforeCondition && (
        <>
          <h2>시공 전 상태</h2>
          <p>{data.beforeCondition}</p>
        </>
      )}

      {hasWorkPerformed && (
        <>
          <h2>진행한 작업</h2>
          <ul>
            {data.workPerformed.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </>
      )}

      {/* 위에 다른 꼭지가 있을 때만 "상세 내용" 제목을 붙입니다. */}
      {(hasBeforeCondition || hasWorkPerformed) && <h2>상세 내용</h2>}
      <Content />
    </div>

    <p style="margin-top:24px;">
      <a href={serviceHref}>{data.category} 서비스 안내 보기 →</a>
      &nbsp;·&nbsp;
      <a href="/cases">다른 시공사례 보기 →</a>
    </p>
  </div>

  <script>
    import { initBeforeAfterSliders } from '../../scripts/before-after';
    initBeforeAfterSliders();
  </script>
</Layout>
