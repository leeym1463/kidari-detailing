---
import Layout from '../layouts/Layout.astro';
import FaqList from '../components/FaqList.astro';
import CasePreview from '../components/CasePreview.astro';
import { business } from '../data/business';
import { faqsByCategory } from '../data/faq';
import { serviceSchema, faqPageSchema, breadcrumbSchema } from '../utils/schema';

const title = '외형복원·판금도색 | 스크래치·판금도색 가격 - 키다리광택 (춘천)';
const description =
  '강원도 춘천 키다리광택의 외형복원·판금도색 서비스 안내. 스크래치 복원과 판금도색 절차, 가격대를 확인하세요.';

const pageFaqs = faqsByCategory('외형복원·판금도색');

const schema = [
  serviceSchema({
    name: '외형복원·판금도색',
    description,
    path: '/restoration',
    serviceType: '자동차 외형복원 및 판금도색',
    lowPrice: 30000,
    highPrice: 400000,
  }),
  faqPageSchema(pageFaqs),
  breadcrumbSchema([
    { name: '홈', path: '/' },
    { name: '외형복원·판금도색', path: '/restoration' },
  ]),
];
---

<Layout title={title} description={description} path="/restoration" schema={schema}>
  <section class="page-hero">
    <div class="wrap">
      <p class="breadcrumb"><a href="/">홈</a> / 외형복원·판금도색</p>
      <h1>외형복원·판금도색</h1>
      <p class="lede">
        외형복원·판금도색은 스크래치와 도장 손상 등 차량 외관의 물리적 손상을 복구하는
        작업입니다. 키다리광택은 광택·유리막코팅과 함께 외형 손상 복원도 진행합니다.
      </p>
    </div>
  </section>

  <div class="wrap section prose">
    <h2>외형복원·판금도색이란</h2>
    <p>
      외형복원은 손상 유형에 따라 접근 방식이 나뉩니다. 표면에 남은 얕은 스크래치는 부분
      연마나 도장 터치업으로 복원하고, 도장 자체가 벗겨지거나 손상이 깊은 경우에는
      판금도색(재도장)을 진행합니다. 손상 부위와 정도를 확인한 후 적절한 방법을 안내해
      드립니다.
    </p>

    <h2>가격 안내</h2>
    <p>
      손상 부위, 크기, 필요한 작업 공정(스크래치 보정 / 판금도색)에 따라 비용이 크게 달라져
      일괄적인 가격을 안내드리기는 어렵습니다. 방문해 주시면 손상 상태를 직접 확인한 뒤
      상담을 통해 정확한 비용을 안내해 드립니다. 방문이 어려우시다면 손상 부위 사진을 미리
      보내주셔도 대략적인 안내가 가능합니다.
    </p>
    <div class="table-scroll">
      <table class="price-table">
        <caption>작업 종류별 예상 소요 시간</caption>
        <thead>
          <tr>
            <th scope="col">작업 종류</th>
            <th scope="col">예상 소요 시간</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>경미한 스크래치 복원</td>
            <td>당일 가능한 경우가 많음</td>
          </tr>
          <tr>
            <td>판금도색</td>
            <td>1일 ~ 3일</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      실제 소요 시간은 손상 부위 수와 정도에 따라 달라질 수 있습니다.
    </p>

    <h2>자주 묻는 질문</h2>
    <FaqList items={pageFaqs} />
    <p style="margin-top:16px;">
      <a href="/faq">전체 FAQ 더 보기 →</a>
    </p>
  </div>

  <section class="section section-alt">
    <div class="wrap">
      <CasePreview category="외형복원·판금도색" />
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2>외형복원·판금도색 문의</h2>
      <p class="section-lead">손상 사진을 미리 보내주시면 더 정확한 견적 안내가 가능합니다.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={business.telephoneHref}>{business.telephoneDisplay} 전화하기</a>
        <a class="btn btn-outline-primary" href="/contact">오시는 길 보기</a>
      </div>
    </div>
  </section>
</Layout>
