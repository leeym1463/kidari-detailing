---
import Layout from '../layouts/Layout.astro';
import { business } from '../data/business';
import { localBusinessSchema, breadcrumbSchema } from '../utils/schema';

const title = '오시는 길 · 문의 | 키다리광택 (춘천)';
const description = `키다리광택 위치, 전화번호, 영업시간 안내. ${business.fullAddressText}`;

const schema = [
  localBusinessSchema(),
  breadcrumbSchema([
    { name: '홈', path: '/' },
    { name: '오시는 길·문의', path: '/contact' },
  ]),
];

const addressQuery = encodeURIComponent(business.fullAddressText);
const kakaoMapUrl = `https://map.kakao.com/link/search/${addressQuery}`;
const naverMapUrl = `https://map.naver.com/v5/search/${addressQuery}`;
---

<Layout title={title} description={description} path="/contact" schema={schema}>
  <section class="page-hero">
    <div class="wrap">
      <p class="breadcrumb"><a href="/">홈</a> / 오시는 길·문의</p>
      <h1>오시는 길 · 문의</h1>
      <p class="lede">
        키다리광택은 {business.fullAddressText}에 위치해 있으며, 전화 상담 후 방문하시면
        더 정확한 견적과 안내를 받으실 수 있습니다.
      </p>
    </div>
  </section>

  <div class="wrap section">
    <div class="contact-grid">
      <div class="info-card">
        <h3>기본 정보</h3>
        <dl>
          <dt>상호</dt>
          <dd>{business.name}</dd>

          <dt>주소</dt>
          <dd>{business.fullAddressText}</dd>

          <dt>전화</dt>
          <dd><a href={business.telephoneHref}>{business.telephoneDisplay}</a></dd>

          <dt>영업시간</dt>
          <dd>
            {business.openingHours[0].opens} ~ {business.openingHours[0].closes}
            <br />
            {business.closedNote}
          </dd>
        </dl>
      </div>

      <div class="info-card">
        <h3>지도에서 보기</h3>
        <p style="color:var(--color-text-muted); font-size:0.94rem; margin:0 0 14px;">
          아래 지도 서비스에서 정확한 위치와 길찾기를 확인하실 수 있습니다.
        </p>
        <div class="cta-row">
          <a class="btn btn-outline-primary" href={kakaoMapUrl} target="_blank" rel="noopener noreferrer">
            카카오맵에서 보기
          </a>
          <a class="btn btn-outline-primary" href={naverMapUrl} target="_blank" rel="noopener noreferrer">
            네이버지도에서 보기
          </a>
        </div>
      </div>

      <div class="info-card">
        <h3>문의 방법</h3>
        <p style="color:var(--color-text-muted); font-size:0.94rem; margin:0 0 14px;">
          정확한 견적은 차량 상태에 따라 달라지므로 전화 상담을 권장합니다. 손상 부위가 있다면
          사진을 함께 준비해 주시면 더 빠른 안내가 가능합니다.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={business.telephoneHref}>{business.telephoneDisplay} 전화하기</a>
          {business.kakaoChannelUrl && (
            <a class="btn btn-outline-primary" href={business.kakaoChannelUrl} target="_blank" rel="noopener noreferrer">
              카카오톡 문의
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</Layout>
