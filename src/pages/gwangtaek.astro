---
import Layout from '../layouts/Layout.astro';
import FaqList from '../components/FaqList.astro';
import CasePreview from '../components/CasePreview.astro';
import { business } from '../data/business';
import { faqsByCategory } from '../data/faq';
import { serviceSchema, faqPageSchema, breadcrumbSchema } from '../utils/schema';

const title = '광택 | FM광택 정석 시공 가격 및 절차 - 키다리광택 (춘천)';
const description =
  '강원도 춘천 키다리광택의 광택 서비스 안내. 막광택을 진행하지 않는 이유, FM광택 정석 시공 절차, 가격대, 유지 기간과 관리 방법을 확인하세요.';

const pageFaqs = faqsByCategory('광택');

const schema = [
  serviceSchema({
    name: '자동차 광택',
    description,
    path: '/gwangtaek',
    serviceType: '자동차 광택 (FM광택 정석 시공)',
    lowPrice: 300000,
    highPrice: 600000,
  }),
  faqPageSchema(pageFaqs),
  breadcrumbSchema([
    { name: '홈', path: '/' },
    { name: '광택', path: '/gwangtaek' },
  ]),
];
---

<Layout title={title} description={description} path="/gwangtaek" schema={schema}>
  <section class="page-hero">
    <div class="wrap">
      <p class="breadcrumb"><a href="/">홈</a> / 광택</p>
      <h1>광택</h1>
      <p class="lede">
        광택은 자동차 도장면을 연마제와 폴리셔로 갈아내어 미세 스크래치와 산화된 클리어층을
        제거하고, 원래의 색감과 광채를 되살리는 작업입니다. 키다리광택은 강원도 춘천에서
        이 광택 공정을 주력으로 하는 디테일링샵입니다.
      </p>
    </div>
  </section>

  <div class="wrap section prose">
    <h2>광택이란</h2>
    <p>
      새 차라도 세차 과정에서 발생하는 미세 스월(swirl) 자국, 자외선에 의한 클리어층 산화,
      주차 흠집 등으로 도장면 표면은 시간이 지날수록 광택이 흐려집니다. 광택 작업은 이런
      표면의 미세한 손상층을 연마제와 폴리셔로 얇게 갈아내어 매끈하고 균일한 면을 만들고,
      그 위에 빛이 고르게 반사되도록 해 원래의 광채를 되살리는 공정입니다. 광택 자체는
      보호막을 씌우는 작업이 아니라 도장면 자체를 다듬는 작업이며, 광택 이후 보호가
      필요하다면 <a href="/coating">유리막코팅</a>을 함께 진행합니다.
    </p>

    <h2>막광택은 진행하지 않습니다</h2>
    <p>
      막광택은 중고차 딜러가 매물을 시장에 내놓기 전, 밑작업 없이 겉보기 광만 빠르게 살리는
      작업입니다. 비용은 저렴하지만 스월과 흠집을 제대로 제거하지 않고 문지르는 경우가 많아
      시간이 지나면 흠집이 금방 다시 드러나는 경우가 많습니다. 키다리광택은 전문
      디테일링샵으로서 막광택 작업은 진행하지 않으며, 모든 광택은 아래의 FM광택 방식으로
      정석 시공합니다.
    </p>

    <h2>FM광택이란</h2>
    <p>
      FM광택은 도장면 상태를 부위별로 점검하며 여러 단계로 나눠 흠집을 세밀하게 제거하는
      정석 공정입니다. 차량 전체를 획일적으로 문지르지 않고, 부위마다 흠집 정도를 확인해
      필요한 연마 강도와 횟수를 다르게 적용합니다. 막광택보다 시간은 더 걸리지만, 그만큼
      결과물의 지속력과 완성도에서 차이가 납니다.
    </p>

    <h2>가격 안내</h2>
    <p>
      FM광택 가격은 <strong>30만원 ~ 60만원</strong>입니다. 차종, 색상, 차량 상태(흠집·산화
      정도 등)에 따라 필요한 연마 단계와 작업 시간이 달라지기 때문에 정해진 한 가지 가격보다는
      이 범위 안에서 차량 상태를 확인한 뒤 안내해 드립니다. 정확한 가격은 방문 또는 전화 상담을
      통해 견적을 받아보시는 것을 권장합니다.
    </p>

    <h2>작업 과정</h2>
    <ol>
      <li>차량 상태 확인 및 흠집 정도 점검</li>
      <li>세차 및 철분 제거 등 사전 작업</li>
      <li>연마제·폴리셔를 이용한 단계별 광택 작업</li>
      <li>마무리 점검 및 잔여물 제거</li>
    </ol>

    <h2>광택 후 관리</h2>
    <p>
      광택 직후에는 도장면이 외부 오염에 상대적으로 예민한 상태이므로, 세차 방법과 보관 환경에
      따라 유지 기간이 달라집니다. 오래 유지하고 싶다면 광택 후 <a href="/coating">유리막코팅</a>으로
      보호막을 씌우는 것을 함께 고려해 볼 수 있습니다.
    </p>

    <h2>자주 묻는 질문</h2>
    <FaqList items={pageFaqs} />
    <p style="margin-top:16px;">
      <a href="/faq">전체 FAQ 더 보기 →</a>
    </p>
  </div>

  <section class="section section-alt">
    <div class="wrap">
      <CasePreview category="광택·유리막코팅" />
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2>광택 문의</h2>
      <p class="section-lead">
        차량 상태에 맞는 정확한 견적은 전화 상담으로 안내해 드립니다.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={business.telephoneHref}>{business.telephoneDisplay} 전화하기</a>
        <a class="btn btn-outline-primary" href="/contact">오시는 길 보기</a>
      </div>
    </div>
  </section>
</Layout>
